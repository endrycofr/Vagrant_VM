# -*- mode: ruby -*-
# vi: set ft=ruby :

require "fileutils"

# ==================================================
# LOAD ENV
# ==================================================
def load_env(file = ".env")
  return unless File.exist?(file)

  File.readlines(file).each do |line|
    line = line.strip
    next if line.empty? || line.start_with?("#")

    key, value = line.split("=", 2)
    next unless key && value

    ENV[key.strip] = value.strip.gsub(/^['"]|['"]$/, "")
  end
end

load_env

# ==================================================
# SSH
# ==================================================
SSH_PRIVATE_KEY = File.expand_path(
  ENV.fetch("SSH_PRIV", "../ssh/k3s.pem")
)

SSH_PUBLIC_KEY = File.expand_path(
  ENV.fetch("SSH_PUB", "../ssh/k3s.pem.pub")
)

def generate_ssh_key(private_key, public_key)
  return if File.exist?(private_key) && File.exist?(public_key)

  puts "Generating SSH key pair..."
  FileUtils.mkdir_p(File.dirname(private_key))

  system("ssh-keygen", "-t", "ed25519", "-f", private_key, "-N", "") or
    abort "ERROR: ssh-keygen failed"
end

generate_ssh_key(SSH_PRIVATE_KEY, SSH_PUBLIC_KEY)

PUBLIC_KEY_CONTENT = File.read(SSH_PUBLIC_KEY).strip

# ==================================================
# GLOBAL CONFIG
# ==================================================

BOX_NAME    = ENV.fetch("BOX",        "ubuntu/jammy64")
HOSTNAME    = ENV.fetch("HOSTNAME",   "minikube-vm")
VM_NAME     = ENV.fetch("VM_NAME",    "minikube-vm")
VM_CPU      = ENV.fetch("CPU",        "4").to_i
VM_MEMORY   = ENV.fetch("MEMORY",     "6144").to_i
VM_DISK     = ENV.fetch("DISK",       "50GB")
PRIVATE_IP  = ENV.fetch("PRIVATE_IP", "192.168.56.10")
AUTO_MINIKUBE = ENV.fetch("AUTO_MINIKUBE", "false")

# ==================================================
# PORT MAPPINGS
# ==================================================
PORT_MAPPINGS = {
  ssh:   [22,  2222],
  http:  [80,  8080],
  https: [443, 8443]
}.freeze


# ==================================================
# PROVISION: BASE SETUP
# ==================================================
BASE_SETUP = <<~SHELL
  set -euo pipefail
  export DEBIAN_FRONTEND=noninteractive

  echo "==> Updating packages..."
  apt-get update -y

  echo "==> Installing dependencies..."
  apt-get install -y \
    curl \
    wget \
    vim \
    git \
    docker.io \
    net-tools \
    conntrack \
    openssh-server

  echo "==> Enabling services..."
  systemctl enable docker ssh
  systemctl restart docker ssh

  echo "==> Configuring vagrant user..."
  usermod -aG docker vagrant

  echo "==> Setting up swap..."
  if [ ! -f /swapfile ]; then
    fallocate -l 2G /swapfile
    chmod 600 /swapfile
    mkswap /swapfile
    swapon /swapfile
    echo "/swapfile none swap sw 0 0" >> /etc/fstab
  fi
SHELL
# ==================================================
# PROVISION: DOCKER SWARM INIT
# ==================================================
INIT_SWARM = <<~SHELL
  set -euo pipefail

  echo "==> Initializing Docker Swarm..."

  if docker info | grep -q "Swarm: active"; then
    echo "Swarm already active"
  else
    docker swarm init --advertise-addr #{PRIVATE_IP}
  fi
SHELL

# ==================================================
# PROVISION: INJECT SSH KEY
# ==================================================
INJECT_SSH_KEY = <<~SHELL
  set -euo pipefail

  echo "==> Injecting SSH public key..."
  install -d -m 700 -o vagrant -g vagrant /home/vagrant/.ssh
  touch /home/vagrant/.ssh/authorized_keys

  grep -qxF "#{PUBLIC_KEY_CONTENT}" /home/vagrant/.ssh/authorized_keys || \
    echo "#{PUBLIC_KEY_CONTENT}" >> /home/vagrant/.ssh/authorized_keys

  chmod 600 /home/vagrant/.ssh/authorized_keys
  chown -R vagrant:vagrant /home/vagrant/.ssh
SHELL

# ==================================================
# PROVISION: INSTALL KUBECTL
# ==================================================
INSTALL_KUBECTL = <<~SHELL
  set -euo pipefail

  echo "==> Installing kubectl..."
  VERSION=$(curl -fsSL https://dl.k8s.io/release/stable.txt)

  curl -fsSLO \
    https://dl.k8s.io/release/${VERSION}/bin/linux/amd64/kubectl

  install -m 0755 kubectl /usr/local/bin/kubectl
  rm -f kubectl

  kubectl version --client
SHELL

# ==================================================
# PROVISION: INSTALL HELM
# ==================================================
INSTALL_HELM = <<~SHELL
  set -euo pipefail

  echo "==> Installing Helm..."
  curl -fsSL \
    https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 \
    | bash

  helm version
SHELL

# ==================================================
# PROVISION: INSTALL MINIKUBE
# ==================================================
INSTALL_MINIKUBE = <<~SHELL
  set -euo pipefail

  echo "==> Installing Minikube..."
  curl -fsSLO \
    https://github.com/kubernetes/minikube/releases/latest/download/minikube-linux-amd64

  install minikube-linux-amd64 /usr/local/bin/minikube
  rm -f minikube-linux-amd64

  minikube version
SHELL

# ==================================================
# PROVISION: START MINIKUBE
# ==================================================
START_MINIKUBE = <<~SHELL
  set -euo pipefail

  echo "==> Starting Minikube..."
  su - vagrant -c '
    minikube start \
      --driver=docker \
      --memory=#{VM_MEMORY - 1024} \
      --cpus=#{VM_CPU}
  '
SHELL

# ==================================================
# VAGRANT
# ==================================================
Vagrant.configure("2") do |config|

  # ==================================================
  # DISK SIZE (requires: vagrant plugin install vagrant-disksize)
  # ==================================================
  config.disksize.size = VM_DISK

  # ==================================================
  # SSH — allow insecure key as fallback for first boot
  # ==================================================
  config.ssh.insert_key      = false
  config.ssh.private_key_path = [
    SSH_PRIVATE_KEY,
    "~/.vagrant.d/insecure_private_key"
  ]

  config.vm.define VM_NAME do |node|

    # ==================================================
    # BASIC
    # ==================================================
    node.vm.box          = BOX_NAME
    node.vm.hostname     = HOSTNAME
    node.vm.boot_timeout = 900

    # ==================================================
    # NETWORK
    # ==================================================
    node.vm.network "private_network", ip: PRIVATE_IP
 
    PORT_MAPPINGS.each do |id, (guest, host)|
      node.vm.network "forwarded_port",
        guest:        guest,
        host:         host,
        id:           id.to_s,
        auto_correct: true
    end

    # ==================================================
    # PROVIDER
    # ==================================================
    node.vm.provider "virtualbox" do |vb|
      vb.name   = VM_NAME
      vb.gui    = false
      vb.memory = VM_MEMORY
      vb.cpus   = VM_CPU

      vb.customize ["modifyvm", :id, "--ioapic",         "on"]
      vb.customize ["modifyvm", :id, "--nictype1",       "virtio"]
      vb.customize ["modifyvm", :id, "--nested-hw-virt", "on"]
    end

    # ==================================================
    # PROVISIONERS (order matters)
    # ==================================================

    # 1. Inject SSH key first so subsequent provisions can connect
    node.vm.provision "shell",
      name:       "inject-ssh-key",
      privileged: true,
      inline:     INJECT_SSH_KEY

    # 2. Copy public key to VM for reference
    node.vm.provision "file",
      source:      SSH_PUBLIC_KEY,
      destination: "/tmp/k3s.pem.pub"

    # 3. Base OS setup
    node.vm.provision "shell",
      name:       "base-setup",
      privileged: true,
      inline:     BASE_SETUP
    # 4. Optionally initialize Docker Swarm
    node.vm.provision "shell",
      name:       "init-swarm",
      privileged: true,
      inline:     INIT_SWARM
    # 5. Optionally start Minikube
    if AUTO_MINIKUBE == "true"
      # 4. Install tooling
      node.vm.provision "shell",
        name:       "install-kubectl",
        privileged: true,
        inline:     INSTALL_KUBECTL

      node.vm.provision "shell",
        name:       "install-helm",
        privileged: true,
        inline:     INSTALL_HELM

      node.vm.provision "shell",
        name:       "install-minikube",
        privileged: true,
        inline:     INSTALL_MINIKUBE
      node.vm.provision "shell",
        name:       "start-minikube",
        privileged: true,
        inline:     START_MINIKUBE
    end

  end

end