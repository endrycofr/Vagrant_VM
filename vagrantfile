Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-22.04"

  nodes = [
    { name: "k3s-master1", private_ip: "192.168.56.11" },
    { name: "k3s-master2", private_ip: "192.168.56.12" },
    { name: "lb",          private_ip: "192.168.56.14" }
  ]

  nodes.each_with_index do |node, index|
    config.vm.define node[:name] do |vm|
      vm.vm.hostname = node[:name]

      # PRIVATE NETWORK (Host-Only → hanya host PC bisa akses)
      vm.vm.network "private_network", ip: node[:private_ip]

      # NAT dengan port forwarding → bisa SSH dari laptop Windows
      vm.vm.network "forwarded_port", guest: 22, host: 2222 + index

      # VMware Desktop provider
      vm.vm.provider "vmware_desktop" do |v|
        v.vmx["displayName"] = node[:name]

        if node[:name] == "lb"
          v.memory = 4096
          v.cpus  = 2
        else
          v.memory = 8192
          v.cpus  = 4
        end
      end

      # COPY SSH PUBLIC KEY
      vm.vm.provision "file",
        source: "k3s.pem.pub",
        destination: "/tmp/k3s.pem.pub"

      # INSTALL SSH & ADD KEY
      vm.vm.provision "shell", inline: <<-SHELL
        set -e
        apt-get update -y
        apt-get install -y openssh-server curl
        systemctl enable ssh
        systemctl start ssh

        mkdir -p /home/vagrant/.ssh
        cat /tmp/k3s.pem.pub >> /home/vagrant/.ssh/authorized_keys
        chown -R vagrant:vagrant /home/vagrant/.ssh
        chmod 700 /home/vagrant/.ssh
        chmod 600 /home/vagrant/.ssh/authorized_keys
      SHELL
    end
  end
end
