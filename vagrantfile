Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"

  nodes = [
    { name: "k3s-master1", ip: "192.168.56.11" },
    { name: "k3s-master2", ip: "192.168.56.12" },
    { name: "k3s-master3", ip: "192.168.56.13" },
    { name: "lb",          ip: "192.168.56.14" }
  ]

  nodes.each do |node|
    config.vm.define node[:name] do |vm|
      vm.vm.hostname = node[:name]
      vm.vm.network "private_network", ip: node[:ip]

      vm.vm.provider "virtualbox" do |vb|
        vb.name = node[:name]
        vb.memory = 2048
        vb.cpus = 2
      end

      # COPY SSH PUBLIC KEY (SETELAH BOOT)
      vm.vm.provision "file",
        source: "D:/ISO OS linux/Virtualbox/vagrant/ssh/k3s.pem.pub",
        destination: "/tmp/k3s.pem.pub"

      # INSTALL & ADD SSH KEY
      vm.vm.provision "shell", inline: <<-SHELL
        sudo apt update -y
        sudo apt install -y openssh-server curl
        sudo systemctl enable ssh
        sudo systemctl start ssh

        sudo mkdir -p /home/vagrant/.ssh
        sudo cat /tmp/k3s.pem.pub >> /home/vagrant/.ssh/authorized_keys
        sudo chown -R vagrant:vagrant /home/vagrant/.ssh
        sudo chmod 700 /home/vagrant/.ssh
        sudo chmod 600 /home/vagrant/.ssh/authorized_keys
      SHELL
    end
  end
end
