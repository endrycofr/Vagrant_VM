Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-22.04"

  nodes = [
    { name: "k3s-master1", ip: "10.200.3.11" },
    { name: "k3s-master2", ip: "10.200.3.12" },
    { name: "lb",          ip: "10.200.3.14" }
  ]

  nodes.each do |node|
    config.vm.define node[:name] do |vm|
      vm.vm.hostname = node[:name]
      vm.vm.network "private_network", ip: node[:ip]

      # VMware Desktop provider
      vm.vm.provider "vmware_desktop" do |v|
        # PERBAIKAN: VMware tidak kenal v.name, gunakan vmx displayName
        v.vmx["displayName"] = node[:name]

        if node[:name] == "lb"
          v.memory = 4096
          v.cpus  = 2
        else
          v.memory = 8192
          v.cpus  = 4
        end
      end

      # COPY SSH PUBLIC KEY
      vm.vm.provision "file",
        source: "k3s.pem.pub",
        destination: "/tmp/k3s.pem.pub"

      # INSTALL & ADD SSH KEY
      vm.vm.provision "shell", inline: <<-SHELL
        set -e
        sudo apt-get update -y
        sudo apt-get install -y openssh-server curl
        sudo systemctl enable ssh
        sudo systemctl start ssh

        sudo mkdir -p /home/vagrant/.ssh
        sudo cat /tmp/k3s.pem.pub >> /home/vagrant/.ssh/authorized_keys
        sudo chown -R vagrant:vagrant /home/vagrant/.ssh
        sudo chmod 700 /home/vagrant/.ssh
        sudo chmod 600 /home/vagrant/.ssh/authorized_keys
      SHELL
    end
  end
end